# PublicLens environment placeholders. Never commit real values.
# On Freebuff Sites these are injected or set under Sites -> Secrets.

# Injected automatically by Sites on deploy.
FREEBUFF_CLIENT_ID=
FREEBUFF_ISSUER=
APP_ORIGIN=

# M2/M3: anti-spam and transactional mail.
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=

# M4 donations use public payment links handled by the owner; no payment
# processor keys are stored by the app.

# Browser-exposed values (bundled at build time, never secret).
VITE_TURNSTILE_SITE_KEY=
